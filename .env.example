# ---------------------------------------------------------------------------
# Meridian configuration. Copy to `.env` and adjust.
# NEVER commit a real .env file. NEVER put a secret in source code.
# Every value below has a working default, so local development needs no .env.
# ---------------------------------------------------------------------------

# --- Platform mode -------------------------------------------------------
# sandbox    : synthetic reference pricing, non-binding indicative quotes only.
# production : requires at least one licensed provider adapter to be configured,
#              otherwise the API refuses to start.
PLATFORM_MODE=sandbox

# --- API server ----------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=47311
LOG_LEVEL=info
# Human-readable log output for local development.
LOG_PRETTY=false

# Comma-separated list of origins allowed to call the API from a browser. The web
# app itself calls the API server-side and needs no CORS grant.
CORS_ORIGINS=http://127.0.0.1:43117,http://localhost:43117

# --- Database ------------------------------------------------------------
# memory   : in-process, non-durable. Default for local development and tests.
# postgres : requires DATABASE_URL and `npm run db:deploy` to have been run.
DATABASE_DRIVER=memory
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=false

# Read by the Prisma CLI (prisma.config.ts) and by the postgres driver. Prisma 7
# no longer accepts a URL in schema.prisma, so this is the single place it lives.
# DATABASE_URL=postgresql://meridian:meridian@127.0.0.1:5432/meridian

# Database integration tests are gated on this rather than on DATABASE_URL, and
# skip entirely when it is unset. Separate on purpose: those tests write and
# delete rows, so nobody should be able to run them against a real database just
# because the usual variable is exported in their shell. Point it at a scratch
# database, apply migrations and seed it before running the suite.
# TEST_DATABASE_URL=postgresql://meridian:meridian@127.0.0.1:5432/meridian_test

# --- Routing engine ------------------------------------------------------
# Default scoring weights. Must sum to exactly 1, so overriding one means
# overriding the set — a partial override changes the sum and fails at startup
# rather than silently rescaling every score. Overridable per request too.
ROUTE_WEIGHT_COST=0.45
ROUTE_WEIGHT_SPEED=0.25
ROUTE_WEIGHT_RELIABILITY=0.1
ROUTE_WEIGHT_SLIPPAGE=0.08
ROUTE_WEIGHT_LIQUIDITY=0.05
ROUTE_WEIGHT_RISK=0.07

# Per-provider quote timeout in milliseconds.
PROVIDER_TIMEOUT_MS=4000

# Rejects a comparison above this notional, in minor units of the source currency.
MAX_COMPARISON_AMOUNT_MINOR_UNITS=100000000000000

# --- Sandbox pricing dataset ---------------------------------------------
# The sandbox rails are priced from versioned data files rather than from
# constants in code. Point this at a different directory to swap the dataset
# (a different scenario, a regression fixture) without a code change.
# MERIDIAN_PRICING_DATA_DIR=packages/adapters/data

# --- Provider credentials (Phase 3+) -------------------------------------
# Sandbox adapters need no credentials. Live adapters resolve their secrets
# through the SecretResolver port, by convention as
# PROVIDER_<UPPER_SNAKE_PROVIDER_ID>_<KEY>, e.g.:
# PROVIDER_ACME_FX_API_KEY=
# PROVIDER_ACME_FX_BASE_URL=

# --- Web app -------------------------------------------------------------
# Where the web app's server-side calls reach the API. Server-side only: the
# browser never receives this value.
API_BASE_URL=http://127.0.0.1:47311
WEB_PORT=43117

# Set true only behind HTTPS. Playwright and local development serve over HTTP.
# COOKIE_SECURE=false

# Force-provision the documented demo tenant when NODE_ENV=test (Playwright does this).
# SEED_DEMO_TENANTS=true

# --- End-to-end tests ----------------------------------------------------
# Playwright starts its own servers on these ports so a run never collides with
# a development server that is already open.
E2E_API_PORT=47411
E2E_WEB_PORT=43217
