# ---------------------------------------------------------------------------
# Meridian configuration. Copy to `.env` and adjust.
# NEVER commit a real .env file. NEVER put a secret in source code.
# ---------------------------------------------------------------------------

# --- Platform mode -------------------------------------------------------
# sandbox    : synthetic reference pricing, non-binding indicative quotes only.
# production : requires at least one licensed provider adapter to be configured,
#              otherwise the API refuses to start.
PLATFORM_MODE=sandbox

# --- API server ----------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=47311
LOG_LEVEL=info

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://127.0.0.1:43117,http://localhost:43117

# --- Persistence ---------------------------------------------------------
# memory   : in-process, non-durable. Default for local development and tests.
# postgres : requires DATABASE_URL and the migration in
#            packages/persistence/migrations to have been applied.
DATABASE_DRIVER=memory
# DATABASE_URL=postgres://meridian:meridian@127.0.0.1:5432/meridian

# --- Routing engine ------------------------------------------------------
# Default scoring weights. Must sum to exactly 1. Overridable per request.
ROUTE_WEIGHT_COST=0.6
ROUTE_WEIGHT_SPEED=0.3
ROUTE_WEIGHT_RELIABILITY=0.1

# Per-provider quote timeout in milliseconds.
PROVIDER_TIMEOUT_MS=4000

# --- Provider credentials (Phase 3+) -------------------------------------
# Sandbox adapters need no credentials. Live adapters resolve their secrets by
# convention as PROVIDER_<UPPER_SNAKE_PROVIDER_ID>_API_KEY, e.g.:
# PROVIDER_ACME_FX_API_KEY=
# PROVIDER_ACME_FX_BASE_URL=

# --- Web app -------------------------------------------------------------
# Base URL of the Meridian API as reachable from the browser.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:47311
WEB_PORT=43117
