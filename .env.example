# ---------------------------------------------------------------------------
# Meridian configuration. Copy to `.env` and adjust.
# NEVER commit a real .env file. NEVER put a secret in source code.
#
# Local development needs no .env: sandbox + in-memory persistence is the default.
# Production and staging MUST set every required variable explicitly. There are no
# production defaults for secrets, demo credentials, or the database driver.
# ---------------------------------------------------------------------------

# =============================================================================
# Environments
# =============================================================================
#
# development
#   NODE_ENV=development (default)
#   PLATFORM_MODE=sandbox (default)
#   DATABASE_DRIVER=memory (default)
#   Demo tenant auto-seeded. Documented sandbox login is allowed.
#   AUTH_SECRET is optional. PRODUCTION_* flags must stay false.
#
# test
#   NODE_ENV=test
#   PLATFORM_MODE=sandbox
#   DATABASE_DRIVER=memory
#   Demo tenants are NOT auto-seeded unless SEED_DEMO_TENANTS=true (Playwright).
#   Rate limiting is off unless RATE_LIMIT_MAX is set.
#
# staging
#   Treat as production-locked. Same fail-closed gates as production (docs/DEPLOYMENT.md).
#   NODE_ENV=production
#   PLATFORM_MODE=production
#   DEPLOY_ENV=staging
#   DATABASE_DRIVER=postgres
#   Require AUTH_SECRET. SEED_DEMO_TENANTS=false. PRODUCTION_EXECUTION_AVAILABLE=false.
#   Staging is not a relaxed sandbox.
#
# production
#   NODE_ENV=production
#   PLATFORM_MODE=production
#   DATABASE_DRIVER=postgres          REQUIRED (memory is rejected)
#   DATABASE_URL=postgresql://...     REQUIRED
#   AUTH_SECRET=<explicit secret>     REQUIRED, min 32 chars, not a demo/default value
#   PRODUCTION_ROUTING_AVAILABLE=false unless licensed partner adapters are configured
#   PRODUCTION_EXECUTION_AVAILABLE=false  (true is always rejected; execution is 501)
#   SEED_DEMO_TENANTS=false           (true is rejected)
#
# See docs/PRODUCTION_GATES.md.

# --- Platform mode -------------------------------------------------------
# sandbox    : synthetic reference pricing, non-binding indicative quotes only.
# production : demo providers are disabled. Financial routing is available only when
#              PRODUCTION_ROUTING_AVAILABLE=true AND licensed partner adapters exist.
#              With no licensed adapters the process may start read-only.
PLATFORM_MODE=sandbox

# --- Production gates (independent) --------------------------------------
# Routing: licensed partner quotes. Default false. True fails closed until a
# licensed adapter is actually registered — this repository has none.
# PRODUCTION_ROUTING_AVAILABLE=false
#
# Execution: always false. POST /api/v1/executions remains 501.
# Setting this true is a startup failure: the platform must not pretend execution exists.
# PRODUCTION_EXECUTION_AVAILABLE=false

# Signed mandate verification/storage (AP2, x402, MPP). Default false — fail closed.
# Does not enable execution, custody, or key holding. POST /executions remains 501.
# MANDATE_INGESTION_ENABLED=false

# Live execution-partner adapters. Default false. This repository has no live adapters;
# even when true the registry still refuses them. Sandbox mocks may simulate dispatch.
# PARTNER_LIVE_ENABLED=false

# Sandbox execution orchestration (mandate + selected route → mock partner). Default false.
# When false, POST /api/v1/executions remains 501. Production-locked processes cannot enable this.
# Does not enable live partners, custody, or principal execution.
# EXECUTION_ENABLED=false

# --- Deployment label ----------------------------------------------------
# development (default in sandbox) | staging | production
# staging and production both require a production-locked process.
# DEPLOY_ENV=staging
# Non-secret image/git identifier published on GET /api/v1/meta.
# MERIDIAN_IMAGE_TAG=

# --- Secrets -------------------------------------------------------------
# Required when NODE_ENV=production or PLATFORM_MODE=production.
# Must be at least 32 characters. Must not be a documented demo password, demo
# agent secret, or a well-known default. The value is never copied into logs.
# AUTH_SECRET=

# Optional. Sales-ops secret for invite-only org create, KYB review, pricing attach,
# monthly invoice generation, and billing reconciliation.
# Compared as SHA-256 against X-Onboarding-Operator-Key. Never copied onto AppConfig.
# If unset or wrong, operator routes return the same 401. Min 32 chars if set; not a demo secret.
# ONBOARDING_OPERATOR_SECRET=

# Force-provision the documented demo tenant. Forbidden in production.
# Playwright sets this so NODE_ENV=test still has the sandbox login.
# SEED_DEMO_TENANTS=true

# --- API server ----------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=47311
LOG_LEVEL=info
# Human-readable log output for local development.
LOG_PRETTY=false

# Comma-separated list of origins allowed to call the API from a browser. The web
# app itself calls the API server-side and needs no CORS grant.
CORS_ORIGINS=http://127.0.0.1:43117,http://localhost:43117

# --- Database ------------------------------------------------------------
# memory   : in-process, non-durable. Default for local development and tests.
#            FORBIDDEN when NODE_ENV=production or PLATFORM_MODE=production.
# postgres : the only approved persistent production database. Requires DATABASE_URL
#            and `npm run db:deploy`. The process does not silently fall back to memory.
DATABASE_DRIVER=memory
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=false

# Read by the Prisma CLI (prisma.config.ts) and by the postgres driver. Prisma 7
# no longer accepts a URL in schema.prisma, so this is the single place it lives.
# DATABASE_URL=postgresql://meridian:meridian@127.0.0.1:5432/meridian

# Database integration tests are gated on this rather than on DATABASE_URL, and
# skip entirely when it is unset. Separate on purpose: those tests write and
# delete rows, so nobody should be able to run them against a real database just
# because the usual variable is exported in their shell. Point it at a scratch
# database, apply migrations and seed it before running the suite.
# TEST_DATABASE_URL=postgresql://meridian:meridian@127.0.0.1:5432/meridian_test

# --- Routing engine ------------------------------------------------------
# Default scoring weights. Must sum to exactly 1, so overriding one means
# overriding the set — a partial override changes the sum and fails at startup
# rather than silently rescaling every score. Overridable per request too.
ROUTE_WEIGHT_COST=0.45
ROUTE_WEIGHT_SPEED=0.25
ROUTE_WEIGHT_RELIABILITY=0.1
ROUTE_WEIGHT_SLIPPAGE=0.08
ROUTE_WEIGHT_LIQUIDITY=0.05
ROUTE_WEIGHT_RISK=0.07

# Multi-rail routing engine 2.0 weights. Independent of the comparison
# engine weights above. Must also sum to exactly 1. Factors: cost, speed,
# finality, fxRate, slippage, liquidity, compliance.
ROUTING_WEIGHT_COST=0.3
ROUTING_WEIGHT_SPEED=0.15
ROUTING_WEIGHT_FINALITY=0.1
ROUTING_WEIGHT_FX_RATE=0.15
ROUTING_WEIGHT_SLIPPAGE=0.1
ROUTING_WEIGHT_LIQUIDITY=0.1
ROUTING_WEIGHT_COMPLIANCE=0.1

# Per-provider quote timeout in milliseconds.
PROVIDER_TIMEOUT_MS=4000

# Rejects a comparison above this notional, in minor units of the source currency.
MAX_COMPARISON_AMOUNT_MINOR_UNITS=100000000000000

# --- Rate limiting -------------------------------------------------------
# Shared limiter on /api/v1. PostgreSQL-backed when DATABASE_DRIVER=postgres
# (required in production) so replicas share the same counters. The memory
# driver keeps an in-process map. Disabled automatically when NODE_ENV=test
# unless RATE_LIMIT_MAX is set (so the test suite can assert 429s).
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120

# --- Sandbox pricing dataset ---------------------------------------------
# The sandbox rails are priced from versioned data files rather than from
# constants in code. Point this at a different directory to swap the dataset
# (a different scenario, a regression fixture) without a code change.
# MERIDIAN_PRICING_DATA_DIR=packages/adapters/data

# --- Provider credentials (Phase 3+) -------------------------------------
# Sandbox adapters need no credentials. Live adapters resolve their secrets
# through the SecretResolver port, by convention as
# PROVIDER_<UPPER_SNAKE_PROVIDER_ID>_<KEY>, e.g.:
# PROVIDER_ACME_FX_API_KEY=
# PROVIDER_ACME_FX_BASE_URL=
# Never put a demo password or the documented agent secret here.

# --- Web app -------------------------------------------------------------
# Where the web app's server-side calls reach the API. Server-side only: the
# browser never receives this value.
API_BASE_URL=http://127.0.0.1:47311
WEB_PORT=43117

# Session cookie flags: HttpOnly and SameSite=Lax always. Secure is required
# when PLATFORM_MODE=production (COOKIE_SECURE=false is a startup failure).
# NODE_ENV=production defaults Secure on. Playwright's HTTP server sets
# COOKIE_SECURE=false without PLATFORM_MODE=production.
# COOKIE_SECURE=true

# --- End-to-end tests ----------------------------------------------------
# Playwright starts its own servers on these ports so a run never collides with
# a development server that is already open.
E2E_API_PORT=47411
E2E_WEB_PORT=43217
