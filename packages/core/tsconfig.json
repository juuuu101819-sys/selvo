{
  // Editor and lint view: covers tests and local config alongside src. The emit graph lives in
  // tsconfig.build.json, which excludes tests so they never reach dist.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "vitest.config.ts"]
}
