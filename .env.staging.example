# Staging secrets for docker compose. Copy to `.env.staging` and fill in.
# NEVER commit `.env.staging`. These names are placeholders only.

# Required. ≥32 characters. Must not be a documented demo password or agent secret.
STAGING_AUTH_SECRET=replace-with-a-unique-staging-auth-secret

# Required. Injected as the Postgres password. Use a unique value per environment.
STAGING_DB_PASSWORD=replace-with-a-unique-staging-db-password

# Optional. Image/git identifier published on GET /api/v1/meta `deployment.imageTag` (not a secret).
MERIDIAN_IMAGE_TAG=local

# Optional. Only used with `docker compose --profile synthetic`. Must not be the demo tenant
# email/password. The org is labelled [SYNTHETIC] and is not production customer data.
# STAGING_OPERATOR_EMAIL=ops@staging.example.invalid
# STAGING_OPERATOR_PASSWORD=replace-with-a-unique-operator-password
